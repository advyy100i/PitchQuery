# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets and local config
.env

# Data and build artefacts. Raw StatsBomb JSON, the pickled TF-IDF index and
# the trained models all live outside the repo (see PITCHQUERY_DATA) — they are
# several GB and fully reproducible from the ingest scripts.
data/
*.pkl
*.npz
*.parquet

# Editor / tooling
.history/
.vscode/
.idea/

# Web
node_modules/
.next/
out/
*.tsbuildinfo

# Personal working notes, not part of the project.
# Delete these two lines if you want the original build plan in the repo.
plan.MD
cost_restriction.txt

# dbt build artefacts. `dbt build` regenerates all of them; the lock file and
# the docs the README links to are committed separately.
warehouse/target/
warehouse/dbt_packages/
warehouse/logs/

# MLflow: SQLite tracking store and run artefacts. Local only — see Phase 5.
mlflow.db
mlruns/

# Prefect's local database, when the server is run without a profile.
.prefect/

# Eval run output. The committed baselines in eval/baselines/ are the contract;
# eval/out/ is whatever the last run measured, and CI uploads it as an artifact.
eval/out/

# The nightly work queue, regenerated by `python -m pipeline.telemetry --write`
# from whatever is in search_log. Grade it and move the queries into
# eval/queries.yaml — the file itself is not the artefact.
eval/candidates.json

# Evidently's HTML drift reports are ~4 MB each and one is written per split per
# run, so committing them grows the repo by 8 MB a night for a page nobody
# diffs. The finding lives in the .md and .json beside them, which are 1.5 KB
# and are committed. Regenerate the HTML with monitoring/drift_report.py.
docs/drift/*.html
