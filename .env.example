# Copy to .env and adjust. Nothing here is required before Phase 3.

# Where raw StatsBomb JSON is cached. Keep this OUTSIDE OneDrive/Dropbox —
# a few hundred matches is several GB.
PITCHQUERY_DATA=C:/Users/advay/pitchquery-data

# Local Postgres from docker-compose.yml. Free.
DATABASE_URL=postgresql://pitchquery:pitchquery@localhost:5433/pitchquery
POSTGRES_PASSWORD=pitchquery

# Phase 6 ONLY. Everything else in this project runs without it.
# Costs ~$5 minimum credit purchase; actual usage is a fraction of a cent per query.
# Leave empty and the planner falls back to keyword rules.
ANTHROPIC_API_KEY=

# --- deployment only -------------------------------------------------------
# Unset locally. A hosted API sets these as real environment variables.

# Comma-separated origins allowed to call the API from a browser. Without the
# deployed frontend's URL here, every request from it is blocked by CORS.
# PITCHQUERY_CORS_ORIGINS=https://pitchquery.vercel.app

# 0 disables the MiniLM dense ranker. torch is ~2.5 GB installed and pushes
# resident memory from 252 MB to 570 MB — past a 512 MB free tier. With it off
# the API serves sparse + shape + planner and says so on /health.
# PITCHQUERY_DENSE=0

# 0 defers the 67k-zone-path cache (~50 MB) to the first drawn query.
# PITCHQUERY_PRELOAD_SHAPES=0
